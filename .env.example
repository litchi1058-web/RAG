# ─── 数据库配置 ───
# DB_TYPE: sqlite | mysql | postgresql
DB_TYPE=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_USER=rag_admin
DB_PASSWORD=rag_pass_2024
DB_NAME=rag_db

# ─── JWT密钥（生产环境务必修改）───
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ─── 服务端口 ───
MAIN_SERVICE_PORT=8000
AI_SERVICE_PORT=8001

# ─── AI服务地址 ───
AI_SERVICE_URL=http://localhost:8001

# ─── LLM 配置 ───
LLM_MODEL_PATH=qwen2-1_5b-instruct-q4_k_m.gguf
LLM_USE_LOCAL=true

# ─── Qwen API 配置（可选，本地模型不可用时回退）───
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen-plus

# ─── 默认管理员 ───
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123

# ─── 上传配置 ───
MAX_FILE_SIZE=10485760
ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif

# ─── 调试模式 ───
DEBUG=false
