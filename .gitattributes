# Auto detect text files and perform LF normalization
* text=auto

# Python files
*.py text eol=lf

# JavaScript/TypeScript files
*.js text eol=lf
*.ts text eol=lf
*.vue text eol=lf

# JSON files
*.json text eol=lf

# Markdown files
*.md text eol=lf

# YAML files
*.yaml text eol=lf
*.yml text eol=lf

# CSS files
*.css text eol=lf

# HTML files
*.html text eol=lf

# Batch files (Windows-specific)
*.bat text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.svg binary
*.gguf binary
*.pth binary
*.pt binary